{
    // General Settings

    // Position TOP
    "layer": "top",
    "margin-bottom": 0,

    // Position BOTTOM
    // "position": "bottom",
    // "margin-top": 0,
    // "margin-bottom": 14,
    
    "margin-left": 0,
    "margin-right": 0,    
    "spacing": 0,

    // Modules Left
    "modules-left": ["custom/waybarthemes","custom/filemanager","custom/terminal","custom/spotify","custom/chatgpt","custom/claude","custom/whatsapp","custom/rofi"],

    // Modules Center
    "modules-center": ["hyprland/workspaces"],

    // Modules Right    
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "battery", 
        "custom/cpu",
        "custom/disk",
        "network",
        "tray",
        "clock",
        "custom/log",
        "custom/power"
    ],
    "custom/cpu": {
        "format": "  {}%",
        "return-type": "json",
        "interval": 1,
        "exec": "echo '{\"text\": \"'$(top -bn1 | grep '%Cpu' | awk '{print int($2)}')'\", \"tooltip\": \"CPU usage: '$(top -bn1 | grep '%Cpu' | awk '{print int($2)}')'%\"}'",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "max-length": 10,
        "min-length": 5
    },
    "custom/disk": {
        "format": "   {}",
        "return-type": "json",
        "interval": 30,
        "exec": "echo '{\"text\": \"'$(df -h / | awk '/\\// {print $5}')'\", \"tooltip\": \"Free: '$(df -h / | awk '/\\// {print $4}')' | Used: '$(df -h / | awk '/\\// {print $3}')' | Total: '$(df -h / | awk '/\\// {print $2}')'\"}'",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "max-length": 10,
        "min-length": 5
    },
    "custom/spotify":{
    "format":" ",
    "on-click":"spotify --enable-gpu-rasterization &",
    "tooltip-format":"Spotify",
    },
    "custom/chatgpt": {
    "format": "󰧑 ",
    "on-click": "~/.config/ml4w/settings/chatgpt.sh",
    "tooltip-format": "ChatGPT",
  },
     "custom/claude": {
    "format": " ",
    "on-click": "~/.config/ml4w/settings/claude.sh",
    "tooltip-format": "Claude",
  },
 "custom/rofi": {
    "format": "R ",
    "on-click": "rofi -show drun &",
    "tooltip-format": "Rofi"
},
  "custom/whatsapp":{
  "format":" ",
  "on-click":"~/.config/ml4w/settings/whatsapp.sh",
  "tooltip-format":"Whatsapp",
  },
     "custom/waybarthemes": {
    "format": "  ",
    "on-click": "waypaper &",
    "tooltip-format": "Select a waybar theme",
  },
  "custom/terminal":{
  "format":" ",
  "on-click":"kitty &",
  "tooltip-format":"Terminal",
  },
  "custom/filemanager": {
    "format": " ",
    "on-click": "thunar &",
    "tooltip-format": "FileManager(Thunar)",
  },
  /*"custom/discord": {
    "format": " ",
    "on-click": "discord",
    "on-click-right":"pkill Discord",
    "tooltip-format": "Discord",
  },*/
    "hyprland/workspaces": {
    "disable-scroll": true,
    "sort-by-name": true,
    "all-outputs": true,
    "persistent-workspaces": {
        "1": "1",
        "2": "2",
        "3": "3",
    },
    "format": "{icon}",
    "format-icons": {
        "1": "1",
        "2": "2",
        "3": "3",
    },
},
     "tray": {
        "icon-size": 25,
        "spacing": 10
    },
    "clock": {
        "timezone": "Asia/Kolkata",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%d/%m/%Y}",
        "format": " {:%H:%M}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
     "bluetooth": {
    "format": " {status}",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": "󰂲"
  },
    "network": {
    "format": "{ifname}",
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "Disconnected ⚠",
    "tooltip-format": " {ifname} via {gwaddri}",
    "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
 },
 "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon}  {time}",
    "format-icons": [" ", " ", " ", " ", " "]
  },
    "custom/log": {
        "tooltip": false,
        "on-click": "wlogout &",
        "format": " "
    },
    "custom/power": {
        "tooltip": false,
        "on-click": "shutdown now &",
        "format": " "
    }
}
